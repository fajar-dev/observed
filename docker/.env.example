# Generate your local .env.docker with: sh docker/setup.sh
COMPOSE_PROJECT_NAME=observed
OBSERVE_IMAGE=observed:local
BUN_VERSION=1.4.4

POSTGRES_DB=observed
POSTGRES_USER=observed
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
OBSERVE_SECRET_KEY=

# The host port may differ; the container always listens on port 3000.
OBSERVE_HTTP_PORT=3000
OBSERVE_BIND_ADDRESS=127.0.0.1
OBSERVE_ORIGIN=http://localhost:3000
OBSERVE_TRUST_PROXY=false
OBSERVE_ALERTS_ENABLED=true

OBSERVE_GOOGLE_ENABLED=false
OBSERVE_GOOGLE_CLIENT_ID=
OBSERVE_GOOGLE_CLIENT_SECRET=
OBSERVE_MICROSOFT_ENABLED=false
OBSERVE_MICROSOFT_CLIENT_ID=
OBSERVE_MICROSOFT_CLIENT_SECRET=
OBSERVE_MICROSOFT_TENANT_ID=
OBSERVE_OAUTH_ALLOW_SIGNUP=false

