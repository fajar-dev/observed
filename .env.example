DATABASE_URL=postgresql://monitoring:monitoring@127.0.0.1:5432/monitoring
OBSERVE_SECRET_KEY=

# Enable only after configuring the provider application and OBSERVE_ORIGIN.
OBSERVE_GOOGLE_ENABLED=false
OBSERVE_GOOGLE_CLIENT_ID=
OBSERVE_GOOGLE_CLIENT_SECRET=

OBSERVE_MICROSOFT_ENABLED=false
OBSERVE_MICROSOFT_CLIENT_ID=
OBSERVE_MICROSOFT_CLIENT_SECRET=
# Specific Microsoft Entra tenant UUID; multi-tenant common/organizations are not accepted.
OBSERVE_MICROSOFT_TENANT_ID=
# New OAuth identities may create Viewer accounts. Existing accounts must link from Profile.
OBSERVE_OAUTH_ALLOW_SIGNUP=false
